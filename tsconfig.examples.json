{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["examples/**/*.js"]
}
