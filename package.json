{
    "name": "imapflow",
    "version": "1.7.8",
    "description": "IMAP Client for Node",
    "type": "module",
    "main": "./dist/cjs/imap-flow.js",
    "types": "./dist/cjs/imap-flow.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/imap-flow.js",
            "require": "./dist/cjs/imap-flow.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "SECURITY.md",
        "SECURITY.txt"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "node scripts/build.js --generate-only && tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-force-exit --test-concurrency=1 $(find test -name '*-test.ts' -not -path '*/integration/*' -not -path '*/cloudflare/*')",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test --test-force-exit --test-concurrency=1 $(find test -name '*-test.ts' -not -path '*/integration/*' -not -path '*/cloudflare/*')",
        "pretest:bun": "npm run build",
        "test:bun": "bun test --timeout 60000 $(find ./test -name '*-test.ts' -not -path '*/integration/*' -not -path '*/cloudflare/*')",
        "pretest:workers": "npm run build",
        "test:workers": "node --import tsx --test test/cloudflare/cloudflare-test.ts",
        "test:rev2": "bash test/integration/run-rev2-tests.sh",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "lint": "eslint . && npm run typecheck",
        "lint:fix": "eslint . --fix",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/imapflow.git"
    },
    "keywords": [
        "imap",
        "email",
        "mail"
    ],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/postalsys/imapflow/issues"
    },
    "homepage": "https://imapflow.com/",
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.10.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "prettier": "3.9.6",
        "tsx": "4.23.13",
        "types-node-legacy": "npm:@types/node@20.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "wrangler": "4.129.0"
    },
    "dependencies": {
        "@zone-eu/mailsplit": "5.4.16",
        "encoding-japanese": "2.3.0",
        "iconv-lite": "0.7.3",
        "libbase64": "1.3.0",
        "libmime": "5.4.3",
        "libqp": "2.1.1",
        "pino": "10.3.1",
        "socks": "2.8.10"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
